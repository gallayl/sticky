---
# Check set focused on real bugs and readability for this ESP8266 project.
# Noisy/irrelevant checks for embedded Arduino code are disabled.
Checks: >
  clang-analyzer-*,
  bugprone-*,
  performance-*,
  readability-*,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-avoid-c-arrays,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-braces-around-statements,
  -readability-implicit-bool-conversion,
  -bugprone-easily-swappable-parameters,
  -clang-analyzer-optin.*

WarningsAsErrors: ''
HeaderFilterRegex: '.*/sticky/src/.*'
FormatStyle: none
...
