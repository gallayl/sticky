CompileFlags:
  # Allow clangd to query the xtensa cross-compiler for its built-in
  # system include paths, and drop GCC-only flags clang doesn't understand.
  Add: [-Wno-unknown-warning-option]
  Remove: [-m*, -f*, -free, -fipa-pta]
  Compiler: /home/lgallay/.platformio/packages/toolchain-xtensa/bin/xtensa-lx106-elf-g++

Diagnostics:
  Suppress: [unknown-argument, drv_unknown_argument]
